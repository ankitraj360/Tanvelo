{
  "name": "tanvelo-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n \"gateway,web\" -c \"cyan,magenta\" \"pnpm --filter @tanvelo/gateway dev\" \"pnpm --filter @tanvelo/web dev\"",
    "dev:gateway": "pnpm --filter @tanvelo/gateway dev",
    "dev:web": "pnpm --filter @tanvelo/web dev",
    "build": "pnpm --filter @tanvelo/db generate && pnpm --filter @tanvelo/db build && pnpm --filter @tanvelo/core build && pnpm --filter @tanvelo/gateway build && pnpm --filter @tanvelo/web build",
    "build:web": "pnpm --filter @tanvelo/web build",
    "build:gateway": "pnpm --filter @tanvelo/db generate && pnpm --filter @tanvelo/db build && pnpm --filter @tanvelo/core build && pnpm --filter @tanvelo/gateway build",
    "start": "pnpm --filter @tanvelo/gateway start",
    "start:gateway": "pnpm --filter @tanvelo/gateway start",
    "start:web": "pnpm --filter @tanvelo/web start",
    "test": "vitest run",
    "test:local": "TEST_DATABASE_URL=\"postgresql://test_user:test_password@localhost:5432/test_tanvelo\" vitest run",
    "test:shared": "ALLOW_SHARED_TEST_DB=true vitest run",
    "db:generate": "pnpm --filter @tanvelo/db generate",
    "db:migrate": "pnpm --filter @tanvelo/db migrate",
    "db:migrate:deploy": "pnpm --filter @tanvelo/db migrate:deploy",
    "db:seed": "pnpm --filter @tanvelo/db seed",
    "db:prune": "pnpm --filter @tanvelo/db prune"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vercel": "^64.5.0",
    "vitest": "^3.0.5"
  }
}
