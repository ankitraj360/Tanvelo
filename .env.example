# Neon PostgreSQL (Cloud Serverless)
DATABASE_URL="postgresql://user:password@ep-example.pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Optional dedicated test database for running vitest
TEST_DATABASE_URL=""
ALLOW_SHARED_TEST_DB="true"

# Redis Cache & Fixed-Window Atomic Rate Limiter
REDIS_URL="redis://localhost:6379"

# Security & Master Encryption Secret (AES-256-GCM 32-byte / 64-hex key)
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Ports & Isolation
GATEWAY_PORT=4000
GATEWAY_HOST=0.0.0.0
NODE_ENV="development"

# Unified Single-Process Mode (set to 'true' for Render/PaaS single-port deployments)
UNIFIED_SERVER="false"

# Management Security & Control Plane
MANAGEMENT_PORT=4001
MANAGEMENT_BIND_HOST=127.0.0.1
# Required (minimum 32 characters). Authenticates internal management API calls from Next.js proxy
MANAGEMENT_API_SECRET="c8e6f1a4d9b2e7c3a0f5d8b1e4c7a2f9c8e6f1a4d9b2e7c3a0f5d8b1e4c7a2f9"
GATEWAY_INTERNAL_URL="http://127.0.0.1:4001"

# Privacy & Logging
LOG_PAYLOADS="false"

# Next.js Web Dashboard
WEB_PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4000"

# Clerk Authentication (tanvelo.in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_publishable_key"
CLERK_SECRET_KEY="sk_live_your_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/overview"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/overview"
